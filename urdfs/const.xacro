<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Constants for robot dimensions.
         Aligned with Unitree's go2.urdf (the one safe_rl trains on): joint limits, motor rotor
         masses, foot, hip collision and IMU placement. Names stay locosim's. -->
    <xacro:property name="PI" value="3.1415926535897931"/>
    <xacro:property name="stick_mass" value="0.00001"/>

    <!-- simplified collision value -->
    <xacro:property name="trunk_width" value="0.0935"/> 
    <xacro:property name="trunk_length" value="0.3762"/>
    <xacro:property name="trunk_height" value="0.114"/>
    <xacro:property name="hip_radius" value="0.046"/>
    <xacro:property name="hip_length" value="0.04"/>
    <!-- lateral offset of the hip collision cylinder (Unitree: 0.08, not the 0.0955 joint offset) -->
    <xacro:property name="hip_collision_offset" value="0.08"/>
    <xacro:property name="upperleg_shoulder_radius" value="0.041"/>
    <xacro:property name="upperleg_shoulder_length" value="0.032"/>
    <xacro:property name="upperleg_width" value="0.0245"/>
    <xacro:property name="upperleg_height" value="0.034"/>
    <xacro:property name="lowerleg_width" value="0.016"/>
    <xacro:property name="lowerleg_height" value="0.016"/>
    <xacro:property name="foot_radius" value="0.022"/>
    <!-- the foot sphere sits 2 mm behind the foot frame -->
    <xacro:property name="foot_collision_offset_x" value="-0.002"/>
    <xacro:property name="stick_radius" value="0.01"/>
    <xacro:property name="stick_length" value="0.2"/>

    <!-- kinematic value -->
    <xacro:property name="upperleg_offset" value="0.0955"/>
    <xacro:property name="upperleg_length" value="0.213"/>
    <xacro:property name="lowerleg_length" value="0.213"/>

    <!-- leg offset from trunk center value -->
    <xacro:property name="leg_offset_x" value="0.1934"/>
    <xacro:property name="leg_offset_y" value="0.0465"/>
    <!-- <xacro:property name="trunk_offset_z" value="0.01675"/> -->
    <xacro:property name="hip_offset" value="0.0955"/>




    <!-- offset of link locations (left front) -->
    <xacro:property name="hip_offset_x" value="0.1934"/>
    <xacro:property name="hip_offset_y" value="0.0465"/>
    <xacro:property name="hip_offset_z" value="0.0"/>
   

    <xacro:property name="upperleg_offset_x" value="0"/>
    <xacro:property name="upperleg_offset_y" value="0.0955"/>
    <xacro:property name="upperleg_offset_z" value="0.0"/>


    <xacro:property name="lowerleg_offset_x" value="0.0"/>
    <xacro:property name="lowerleg_offset_y" value="0.0"/>
    <xacro:property name="lowerleg_offset_z" value="-0.213"/>
 

    <!-- joint limits -->
    <!-- Joint model the RL policies are trained with: the PACE fit of the real robot
         (safe_rl/assets.py, UNITREE_GO2_IDENTIFIED), averaged over the four legs per joint type.
         Coulomb friction N m, viscous damping N m s/rad, reflected rotor inertia (armature) kg m^2,
         applied by libjoint_armature_plugin (leg.xacro) since ODE has no armature. -->
    <xacro:property name="joint_coulomb" value="${dict(haa=0.24, hfe=0.23, kfe=0.8)}"/>
    <xacro:property name="joint_viscous" value="${dict(haa=0.25, hfe=0.22, kfe=0.29)}"/>
    <xacro:property name="joint_armature" value="${dict(haa=0.02, hfe=0.023, kfe=0.037)}"/>

    <!-- Contact damping, N s/m (leg.gazebo.xacro and the body): at 100 the feet bounce on touchdown. -->
    <xacro:property name="contact_kd" value="3000.0"/>
    <xacro:property name="haa_max" value="1.0472"/>
    <xacro:property name="haa_min" value="-1.0472"/>
    <xacro:property name="haa_velocity_max" value="30.1"/>
    <xacro:property name="haa_torque_max" value="23.7"/>
    <xacro:property name="hfe_max" value="3.4907"/>
    <xacro:property name="hfe_min" value="-1.5708"/>
    <!-- the hind thighs have a different range from the front ones -->
    <xacro:property name="hfe_max_hind" value="4.5379"/>
    <xacro:property name="hfe_min_hind" value="-0.5236"/>
    <xacro:property name="hfe_velocity_max" value="30.1"/>
    <xacro:property name="hfe_torque_max" value="23.7"/>
    <xacro:property name="kfe_max" value="-0.83776"/>
    <xacro:property name="kfe_min" value="-2.7227"/>
    <xacro:property name="kfe_velocity_max" value="15.70"/>
    <xacro:property name="kfe_torque_max" value="45.43"/>

    <!-- dynamics inertial value -->
    <!-- trunk -->
    <xacro:property name="trunk_mass" value="6.921"/>
    <xacro:property name="trunk_com_x" value="0.021112"/>
    <xacro:property name="trunk_com_y" value="0.00"/>
    <xacro:property name="trunk_com_z" value="-0.005366"/>
    <xacro:property name="trunk_ixx" value="0.02448"/>
    <xacro:property name="trunk_ixy" value="0.00012166"/>
    <xacro:property name="trunk_ixz" value="0.0014849"/>
    <xacro:property name="trunk_iyy" value="0.098077"/>
    <xacro:property name="trunk_iyz" value="-3.12E-05"/>
    <xacro:property name="trunk_izz" value="0.107"/>

    <!-- hip (left front) -->
    <xacro:property name="hip_mass" value="0.678"/>
    <xacro:property name="hip_com_x" value="-0.0054"/>
    <xacro:property name="hip_com_y" value="0.00194"/>
    <xacro:property name="hip_com_z" value="-0.000105"/>
    <xacro:property name="hip_ixx" value="0.00048"/>
    <xacro:property name="hip_ixy" value="-3.01E-06"/>
    <xacro:property name="hip_ixz" value="1.11E-06"/>
    <xacro:property name="hip_iyy" value="0.000884"/>
    <xacro:property name="hip_iyz" value="-1.42E-06"/>
    <xacro:property name="hip_izz" value="0.000596"/>

    <!-- upperleg -->
    <xacro:property name="upperleg_mass" value="1.152"/>
    <xacro:property name="upperleg_com_x" value="-0.00374"/>
    <xacro:property name="upperleg_com_y" value="-0.0223"/>
    <xacro:property name="upperleg_com_z" value="-0.0327"/>
    <xacro:property name="upperleg_ixx" value="0.00584"/>
    <xacro:property name="upperleg_ixy" value="8.72E-05"/>
    <xacro:property name="upperleg_ixz" value="-0.000289"/>
    <xacro:property name="upperleg_iyy" value="0.0058"/>
    <xacro:property name="upperleg_iyz" value="0.000808"/>
    <xacro:property name="upperleg_izz" value="0.00103"/>

    <!-- lowerleg -->
    <xacro:property name="lowerleg_mass" value="0.154"/>
    <xacro:property name="lowerleg_com_x" value="0.00548"/>
    <xacro:property name="lowerleg_com_y" value="-0.000975"/>
    <xacro:property name="lowerleg_com_z" value="-0.115"/>
    <xacro:property name="lowerleg_ixx" value="0.00108"/>
    <xacro:property name="lowerleg_ixy" value="3.4E-07"/>
    <xacro:property name="lowerleg_ixz" value="1.72E-05"/>
    <xacro:property name="lowerleg_iyy" value="0.0011"/>
    <xacro:property name="lowerleg_iyz" value="8.28E-06"/>
    <xacro:property name="lowerleg_izz" value="3.29E-05"/>


    <!-- foot -->
    <xacro:property name="foot_mass" value="0.04"/>
    <xacro:property name="foot_inertia" value="9.6e-06"/>

    <!-- motor rotors, fixed to the body that carries each motor (Unitree's *_rotor links):
         haa rotor on the trunk, hfe rotor on the hip, kfe rotor on the upper leg.
         Offsets are for the left front leg; y flips with mirror, x with front_hind. -->
    <xacro:property name="rotor_mass" value="0.089"/>
    <xacro:property name="rotor_i_axis" value="0.000111842"/>
    <xacro:property name="rotor_i_radial" value="0.000059647"/>
    <xacro:property name="haa_rotor_offset_x" value="0.11215"/>
    <xacro:property name="haa_rotor_offset_y" value="0.04675"/>
    <xacro:property name="hfe_rotor_offset_y" value="-0.00015"/>
    <xacro:property name="kfe_rotor_offset_y" value="-0.03235"/>

</robot>
